@model MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>

               
@using (Html.BeginForm())
{
   @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <hr />
        <h4>Bạn xác nhận muốn xóa danh mục này không?</h4>
        <div class="form-group">
            <div class="control-label col-sm-2">Tên Danh Mục</div>
            <div class="col-md-10">
                @* Giá trị của trường CategoryName *@
                @Html.DisplayFor(model => model.CategoryName)
            </div>
        </div>
    
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-primary" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}
